      "PropertyInspectorPath": "ui/stat.html",
      "Controllers": [
        "Keypad"
      ],
      "States": [
        {
          "Image": "imgs/actions/stat/key",
          "TitleAlignment": "middle",
          "ShowTitle": false
        }
      ],
      "UserTitleEnabled": false
    },
    {
      "Name": "Today's Totals",
      "UUID": "com.jonny2352.walkingpad.today",
