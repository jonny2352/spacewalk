    {
      "Name": "Speed Dial (Stream Deck +)",
      "UUID": "com.jonny2352.walkingpad.dial",
      "Icon": "imgs/actions/dial/icon",
      "Tooltip": "Rotate to change speed, press to stop.",
      "PropertyInspectorPath": "ui/dial.html",
      "Controllers": [
        "Encoder"
      ],
      "UserTitleEnabled": false,
      "Encoder": {
        "layout": "layouts/walkingpad.json",
        "TriggerDescription": {
          "Rotate": "Change speed",
          "Push": "Stop belt"
        },
        "Icon": "imgs/actions/dial/key"
      },
      "States": [
        {
          "Image": "imgs/actions/dial/key",
          "TitleAlignment": "middle",
          "ShowTitle": false
        }
      ]
