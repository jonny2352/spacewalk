{
  "Name": "Walking Pad",
  "Version": "0.1.0.0",
  "Author": "jonny2352",
  "Actions": [
    {
      "Name": "Start / Resume",
      "UUID": "com.jonny2352.walkingpad.start",
      "Icon": "imgs/actions/start/icon",
      "Tooltip": "Start or resume the belt. First press arms the key, second press starts (configurable).",
      "PropertyInspectorPath": "ui/start.html",
      "Controllers": [
        "Keypad"
      ],
      "States": [
        {
          "Image": "imgs/actions/start/key",
          "TitleAlignment": "middle",
          "ShowTitle": false
        }
      ],
      "UserTitleEnabled": false
    },
    {
      "Name": "Stop (Emergency)",
      "UUID": "com.jonny2352.walkingpad.stop",
      "Icon": "imgs/actions/stop/icon",
